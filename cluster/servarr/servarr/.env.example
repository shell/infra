# Servarr Stack Configuration
# Copy this file to .env and fill in your values

# User/Group IDs for container permissions (run `id` to find yours)
USER_ID=1000
GROUP_ID=1000

# Timezone (find yours at: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE="America/Los_Angeles"

# Paths - adjust to match your system
DOCKER_ROOT="/home/username/servarr"
DATA_ROOT="/mnt/data"

# Private Internet Access VPN credentials
# Get from: https://www.privateinternetaccess.com/account/client-control-panel
PIA_LOCATION=us_east
PIA_USER=your_pia_username
PIA_PASS=your_pia_password
PIA_LOCAL_NETWORK="192.168.0.0/16"

# qBittorrent WebUI login, used by pia-shared/portupdate-qbittorrent.sh to set
# the forwarded port. Same credentials as the qBittorrent WebUI.
QBT_USER=admin
QBT_PASS=CHANGE_ME

# *arr API Keys (auto-generated by the services after first run)
# Extract from: ${DOCKER_ROOT}/sonarr/config/config.xml etc.
# Or run: ./update-config.sh to auto-extract
SONARR_API_KEY=
RADARR_API_KEY=
