# Tube Archivist Configuration
# Copy this file to .env and fill in your values

# User/Group IDs (run `id` to find yours)
USER_ID=1000
GROUP_ID=1000

# Timezone
TIMEZONE=America/Los_Angeles

# Paths - adjust to match your system
DATA_ROOT=/mnt/data
DOCKER_DATA_ROOT=/home/username/tubearchivist-config

# Tube Archivist settings
TA_HOST=https://tube.yourdomain.com

# Initial admin credentials (change after first login!)
TA_USERNAME=admin
TA_PASSWORD=change_this_password

# Elasticsearch password (must match between services)
# Generate a strong password: openssl rand -base64 32
ELASTIC_PASSWORD=change_this_password
