# Generate with: openssl rand -hex 24 / openssl rand -hex 32
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME
# Operator token: InfluxDB setup only. Don't hand it to clients.
INFLUXDB_ADMIN_TOKEN=CHANGE_ME
# WRITE access to the proxmox bucket only, used by Proxmox (proxmox-metrics.yml).
# Create it in the InfluxDB UI: Load Data → API Tokens → Custom API Token.
# (Grafana's read-only token is GRAFANA_INFLUXDB_TOKEN in ../grafana/.env.enc.)
INFLUXDB_PROXMOX_TOKEN=CHANGE_ME
