USER_ID=1000
GROUP_ID=1000
TIMEZONE="America/Los_Angeles"
# Generate with: openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# InfluxDB API token with READ access to the proxmox bucket only (not the admin
# token). Create it in the InfluxDB UI: Load Data → API Tokens → Custom API Token
GRAFANA_INFLUXDB_TOKEN=CHANGE_ME
GRAFANA_OIDC_CLIENT_SECRET=CHANGE_ME