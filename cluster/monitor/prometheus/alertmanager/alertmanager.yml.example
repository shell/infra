# AlertManager Configuration Template
# Copy this file to alertmanager.yml and fill in your Telegram credentials
#
# See https://github.com/prometheus/alertmanager/pull/2827
# https://prometheus.io/docs/alerting/latest/configuration/#telegram_config

route:
  group_by: ['alertname']
  group_wait: 1m
  group_interval: 5m
  repeat_interval: 1h
  receiver: 'telegram'

receivers:
  - name: 'telegram'
    telegram_configs:
    - api_url: https://api.telegram.org
      # Create a bot via @BotFather on Telegram
      bot_token: 'YOUR_TELEGRAM_BOT_TOKEN'
      # Get your chat ID by messaging @userinfobot
      chat_id: YOUR_TELEGRAM_CHAT_ID
