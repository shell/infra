# Nebula-Sync Configuration (Pi-hole sync)
# Copy this file to .env and fill in your values

# Primary Pi-hole instance (format: "URL|API_PASSWORD")
PRIMARY="https://pihole.yourdomain.com|your_pihole_api_password"

# Replica Pi-hole instances (format: "URL|API_PASSWORD", comma-separated for multiple)
REPLICAS="https://pihole2.yourdomain.com|your_pihole_api_password"

# Sync options
FULL_SYNC=false
RUN_GRAVITY=false

# Cron schedule (every 15 minutes by default)
CRON=*/15 * * * *

# Skip TLS verification for self-signed certs
CLIENT_SKIP_TLS_VERIFICATION=true

# Timezone
TZ=America/Los_Angeles

# What to sync
SYNC_CONFIG_DNS=true
SYNC_CONFIG_DHCP=false
SYNC_CONFIG_NTP=false
SYNC_CONFIG_RESOLVER=false
SYNC_CONFIG_DATABASE=false
SYNC_CONFIG_MISC=false
SYNC_CONFIG_DEBUG=false

# Gravity sync settings
SYNC_GRAVITY_DHCP_LEASES=false
SYNC_GRAVITY_GROUP=false
SYNC_GRAVITY_AD_LIST=true
SYNC_GRAVITY_AD_LIST_BY_GROUP=true
SYNC_GRAVITY_DOMAIN_LIST=true
SYNC_GRAVITY_DOMAIN_LIST_BY_GROUP=true
SYNC_GRAVITY_CLIENT=false
SYNC_GRAVITY_CLIENT_BY_GROUP=false
