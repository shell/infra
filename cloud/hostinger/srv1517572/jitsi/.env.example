# Jitsi Meet configuration for meet.penk.in
# Copy to .env, fill in secrets, then encrypt with:
#   sops --encrypt --input-type dotenv --output-type dotenv .env > .env.enc

# =============================================================
# Public
# =============================================================
PUBLIC_URL=https://meet.penk.in
TZ=UTC
CONFIG=/home/vlad/.jitsi-meet-cfg
RESTART_POLICY=unless-stopped

# =============================================================
# Auth — registered users create meetings, guests can join
# =============================================================
ENABLE_AUTH=1
AUTH_TYPE=internal
ENABLE_GUESTS=1

# =============================================================
# Branding
# =============================================================
APP_NAME=VA Family

# =============================================================
# JVB (Video Bridge)
# =============================================================
JVB_ADVERTISE_IPS=<VPS_IP>
JVB_PORT=10000
JVB_STUN_SERVERS=meet-jit-si-turnserver.jitsi.net:443,stun.l.google.com:19302

# =============================================================
# XMPP
# =============================================================
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_SERVER=xmpp.meet.jitsi

# =============================================================
# Secrets — generate with: openssl rand -hex 16
# =============================================================
JICOFO_AUTH_PASSWORD=CHANGE_ME
JVB_AUTH_PASSWORD=CHANGE_ME
