# Umami configuration for srv1517572
# Copy to .env, fill in secrets, then encrypt with:
#   sops --encrypt --input-type dotenv --output-type dotenv .env > .env.enc

# =============================================================
# PostgreSQL password
# Generate with: openssl rand -hex 24
# IMPORTANT: must be URL-safe (no /, +, =) as it's used in DATABASE_URL
# =============================================================
POSTGRES_PASSWORD=CHANGE_ME

# =============================================================
# App secret — used for signing session cookies
# Generate with: openssl rand -hex 32
# =============================================================
APP_SECRET=CHANGE_ME
