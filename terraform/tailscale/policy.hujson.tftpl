// Tailnet policy. Rendered by policy.tf: the users.<name> placeholders come
// from the 1Password item "tailscale-users". Edit here, not in the admin console.
//
// Model: people get everything, machines get nothing. Infrastructure devices
// are tagged by function and appear in no grant as a source, so they only
// accept and forward traffic and never open connections into the tailnet.
{
	// Homelab LAN (192.168.10.0/24), reached through the tag:router subnet routers
	"hosts": {
		"lan":     "192.168.10.0/24",
		"k8s-api": "192.168.10.20",
		"pve-nuc": "192.168.10.120",
		"ts-router": "192.168.10.141",
		"servarr": "192.168.10.142",
		"tools":   "192.168.10.143",
		"pi-hole": "192.168.10.198",
		"monitor": "192.168.10.230",
		"k8s-lb":  "192.168.10.240/28", // MetalLB pool .240-.249
		"runner":  "192.168.10.252",
	},

	// Tags by function; a device can carry several (terraform/tailscale/devices.tf)
	//   tag:router    ts-router (VM), ts-router-nuc (LXC): LAN subnet route
	//   tag:exit-node routers, zima-msk, zima-rov, srv1517572: exit node
	//   tag:relay     srv1517572 (Hostinger VPS): peer relay
	//   tag:terraform the Terraform OAuth client; it can apply the tags it owns
	"tagOwners": {
		"tag:terraform": ["autogroup:admin"],
		"tag:router":    ["autogroup:admin", "tag:terraform"],
		"tag:exit-node": ["autogroup:admin", "tag:terraform"],
		"tag:relay":     ["autogroup:admin", "tag:terraform"],
	},

	// Routes approve themselves when a tagged device (re)advertises them.
	// routes.tf records the same approvals explicitly.
	"autoApprovers": {
		"routes":   {"192.168.10.0/24": ["tag:router"]},
		"exitNode": ["tag:exit-node"],
	},

	"grants": [
		// People: every device and the LAN
		{
			"src": ["autogroup:member"],
			"dst": ["*"],
			"ip":  ["*"],
		},
		// People: the internet through any exit node ("*" doesn't include it)
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},
		// Relay through the VPS when direct paths are slow or blocked. Tagged
		// devices behind other people's NATs (zimas) need it too; this is an
		// app capability only and grants them no IP access.
		{
			"src": ["autogroup:member", "tag:exit-node", "tag:router"],
			"dst": ["tag:relay"],
			"app": {"tailscale.com/cap/relay": []},
		},
	],

	// Tailscale SSH to your own untagged devices only; infra uses LAN SSH with the SSH CA
	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	// Run on every save; a failing test rejects the policy
	"tests": [
		{
			"src": "${users.admin}",
			"accept": [
				"pve-nuc:8006", "servarr:443", "monitor:443", "pi-hole:53", "k8s-api:6443",
				"tag:router:22", "tag:exit-node:22", "tag:relay:22",
			],
		},
		{
			"src": "${users.ann}",
			"accept": [
				"pve-nuc:8006", "servarr:443", "monitor:443", "pi-hole:53", "k8s-api:6443",
				"tag:router:22", "tag:exit-node:22", "tag:relay:22",
			],
		},
		// Infrastructure initiates nothing
		{
			"src":  "tag:router",
			"deny": ["pve-nuc:8006", "pi-hole:53", "tag:router:22", "tag:exit-node:22", "tag:relay:22"],
		},
		{
			"src":  "tag:exit-node",
			"deny": ["pve-nuc:8006", "pi-hole:53", "tag:router:22", "tag:exit-node:22", "tag:relay:22"],
		},
		{
			"src":  "tag:relay",
			"deny": ["pve-nuc:8006", "pi-hole:53", "tag:router:22", "tag:exit-node:22", "tag:relay:22"],
		},
	],
}
